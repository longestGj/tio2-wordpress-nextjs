WORDPRESS_DB_NAME=tio2_my_prerelease
WORDPRESS_DB_USER=tio2_my_prerelease
WORDPRESS_DB_PASSWORD=replace-with-local-database-password
WORDPRESS_DB_ROOT_PASSWORD=replace-with-local-root-password
WORDPRESS_ADMIN_USER=tio2-prerelease-editor
WORDPRESS_ADMIN_PASSWORD=replace-with-local-admin-password
WORDPRESS_ADMIN_EMAIL=admin@example.test
NEXTJS_REVALIDATION_SECRET_TIO2_MY=replace-with-local-revalidation-secret
NEXTJS_PREVIEW_SECRET_TIO2_MY=replace-with-local-preview-secret
# Generate an independent local prerelease secret; shared only with this stack's CMS.
WORDPRESS_EDITORIAL_API_TOKEN=replace-with-isolated-editorial-secret
NEXT_PUBLIC_TIO2_MY_WEB3FORMS_ACCESS_KEY=replace-with-approved-web3forms-access-key
PRERELEASE_LIVE_FORMS_ENABLED=false
TIO2_MY_RFQ_ATTRIBUTION_SECRET=replace-with-local-attribution-secret
# Private JSON: site_scope, recipient, key_sha256 matching the existing key. Never commit actual values.
TIO2_MY_SAMPLE_RECEIVER_BINDING=
PRERELEASE_SOURCE_DIR=D:/replace-with-frozen-source
PRERELEASE_RUN_DIR=D:/replace-with-run-directory
