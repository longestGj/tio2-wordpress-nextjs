import {chromium} from '@playwright/test'
import {mkdtempSync,mkdirSync,writeFileSync} from 'node:fs'
import {resolve} from 'node:path'
import sharp from 'sharp'
const root=resolve('docs/verification/tio2-my/market-eu-pl/gate9-fixes-v03/zoom-diagnostic')
mkdirSync(root,{recursive:true})
const work=mkdtempSync(resolve('.tmp/poland-zoom-debug-')),extension=resolve(work,'extension')
mkdirSync(extension)
writeFileSync(resolve(extension,'manifest.json'),JSON.stringify({manifest_version:3,name:'Local zoom diagnostic',version:'1.0',permissions:['tabs'],host_permissions:['http://127.0.0.1/*'],background:{service_worker:'worker.js'}}))
writeFileSync(resolve(extension,'worker.js'),'chrome.runtime.onInstalled.addListener(()=>{});')
const context=await chromium.launchPersistentContext(resolve(work,'profile'),{channel:'chromium',headless:true,viewport:null,args:['--window-size=1440,1000',`--disable-extensions-except=${extension}`,`--load-extension=${extension}`]})
try{
 const worker=context.serviceWorkers()[0]??await context.waitForEvent('serviceworker')
 const page=await context.newPage();const response=await page.goto('http://127.0.0.1:3015/markets/poland/');const html=await response.text();if(!html.includes('GjJdupnweqs0MK5nxZvnV'))throw Error('Wrong build')
 await page.evaluate(()=>document.fonts.ready)
 await worker.evaluate(async()=>{const tabs=await chrome.tabs.query({});const tab=tabs.find(t=>t.url.includes('/markets/poland'));await chrome.tabs.setZoom(tab.id,2)})
 const cdp=await context.newCDPSession(page),ledger=[]
 const sample=async(state)=>{
  await page.evaluate(()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r))))
  const geometry=await page.evaluate(()=>({innerWidth,innerHeight,outerWidth,outerHeight,dpr:devicePixelRatio,scrollY,visualScale:visualViewport.scale,scrollWidth:document.documentElement.scrollWidth,scrollHeight:document.documentElement.scrollHeight,active:document.activeElement?.outerHTML,dialog:[...document.querySelectorAll('dialog')].map(n=>({rect:n.getBoundingClientRect().toJSON(),modal:n.matches(':modal'),text:n.innerText}))}))
  const metrics=await cdp.send('Page.getLayoutMetrics')
  const variants=[['pw',await page.screenshot()],['cdp-surface',Buffer.from((await cdp.send('Page.captureScreenshot',{format:'png',fromSurface:true,captureBeyondViewport:false})).data,'base64')],['cdp-view',Buffer.from((await cdp.send('Page.captureScreenshot',{format:'png',fromSurface:false,captureBeyondViewport:false})).data,'base64')]]
  for(const [name,bytes]of variants){writeFileSync(`${root}/${state}-${name}.png`,bytes);const metadata=await sharp(bytes).metadata(),stats=await sharp(bytes).stats();ledger.push({state,name,geometry,metrics,image:{width:metadata.width,height:metadata.height,minmax:stats.channels.map(c=>[c.min,c.max])}})}
 }
 await sample('page')
 await page.getByRole('button',{name:'Open primary navigation',exact:true}).focus();await page.keyboard.press('Enter');await sample('menu');await page.keyboard.press('Escape')
 await page.getByRole('button',{name:'Cookie Settings',exact:true}).focus();await page.keyboard.press('Enter');await sample('cookie')
 writeFileSync(root+'/ledger.json',JSON.stringify(ledger,null,2))
 console.log(JSON.stringify(ledger.map(({state,name,image,geometry,metrics})=>({state,name,image,viewport:[geometry.innerWidth,geometry.innerHeight],layout:metrics.layoutViewport,css:metrics.cssLayoutViewport}))))
}finally{await context.close()}
