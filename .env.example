SITE_ID=tio2-a
WORDPRESS_GRAPHQL_URL=http://localhost:8080/graphql
# Exact WordPress origin; Site A editorial media is limited to /wp-content/uploads/.
WORDPRESS_MEDIA_ORIGIN=http://localhost:8080
PREVIEW_SECRET=SET_TO_THIS_SITE_PREVIEW_SECRET
REVALIDATION_SECRET=SET_TO_THIS_SITE_REVALIDATION_SECRET
WORDPRESS_PREVIEW_URL=http://127.0.0.1:8080/wp-json/tio2/v1/preview
WORDPRESS_PREVIEW_SECRET=SET_TO_THIS_SITE_PREVIEW_SECRET
NEXT_DIST_DIR=.next-tio2-a
VERCEL_ENV=development
# Test-only opt-in for production SEO output on the approved domains.
# Keep unset/false for normal local development.
SEO_ALLOW_INDEXING_LOCAL_TEST=false

# Shared TiO2 Malaysia Web3Forms routing key for RFQ, Request Documents, and
# Request a Sample. Bind its recipient in the provider account.
NEXT_PUBLIC_TIO2_MY_WEB3FORMS_ACCESS_KEY=
TIO2_MY_PRIVACY_POLICY_HREF=
TIO2_MY_SHARED_CONSENT_READY=false
TIO2_MY_REQUEST_SAMPLE_READY=false
TIO2_MY_REQUEST_DOCUMENTS_READY=false
# Independent Gate 10/release signal. Contract authorization and production
# environment must also pass before CONV-RFQ can emit index,follow.
TIO2_MY_RFQ_INDEXING_RELEASE_AUTHORIZED=false

# Sample server receiver: verified site/recipient binding for the SAME routing key.
# key_sha256 is the lowercase SHA-256 of that key, checked server-side; no browser override.
# Actual provider account recipient and inbox must be independently checked.
TIO2_MY_SAMPLE_RECEIVER_BINDING=
# Absolute persistent writable directory. Store only keyed payload digest/status, no buyer fields.
# Keep this directory across restarts and share it between workers; do not use ephemeral deployment storage.
TIO2_MY_SAMPLE_RECEIPT_DIRECTORY=
